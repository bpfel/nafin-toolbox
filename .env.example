# nafin-toolbox — Production Environment Variables
# Copy to .env and fill in all values before deploying.

# Database
POSTGRES_PASSWORD=<generate-strong-password>

# App
APP_URL=https://<your-subdomain>
CORS_ORIGINS=https://<your-subdomain>
ENCRYPTION_KEY=<run: openssl rand -hex 32>

# Where the frontend is published. Default 4000, on every interface. With the
# reverse proxy on the same host, publish on loopback only:
# NAFIN_LISTEN=127.0.0.1:4000

# SMTP (Infomaniak)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USERNAME=<your-email@domain>
SMTP_PASSWORD=<email-password>
SMTP_FROM=<your-email@domain>
